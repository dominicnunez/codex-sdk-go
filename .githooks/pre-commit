#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
runner="$repo_root/scripts/hooks/run.sh"

# The dedicated module ignores working module contents while allowing the
# checker to reuse the repository's process-tree controls.
temporary=$(mktemp -d)
child=
building=1
cleanup() { rm -rf -- "$temporary"; }
stop_child() {
  trap '' TERM INT HUP
  if [[ -n "$child" ]]; then
    if [[ "$building" = 1 ]]; then
      echo 'pre-commit: waiting for bootstrap build before stopping' >&2
    else
      kill -TERM "$child" 2>/dev/null || true
    fi
    wait "$child" 2>/dev/null || true
  fi
  exit 1
}
trap cleanup EXIT
trap stop_child TERM INT HUP
run_child() {
  local interrupted=0
  trap 'interrupted=1' TERM INT HUP
  "$@" <&0 &
  child=$!
  trap stop_child TERM INT HUP
  if [[ "$interrupted" = 1 ]]; then stop_child; fi
  wait "$child"
  child=
}
run_child env GO111MODULE=on GOWORK=off GOENV=off GOFLAGS= "$runner" \
  go build -modfile="$repo_root/scripts/hooks/bootstrap.mod" -buildvcs=false \
  -o "$temporary/checker.exe" "$repo_root/scripts/hooks"
building=0
run_child "$temporary/checker.exe" pre-commit
