#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
runner="$repo_root/scripts/hooks/run.sh"

# Bootstrap the standard-library-only checker independently of working module
# edits. The captured staged module is loaded during snapshot validation.
exec env GO111MODULE=off GOWORK=off GOENV=off GOFLAGS= "$runner" \
  go run -buildvcs=false "$repo_root/scripts/hooks/check.go" pre-commit
